NobleStars.xcodeproj/

# macOS
.DS_Store

# Swift Package Manager (future)
.build/
build/

# The HTML menu was deleted (its art moved into godot/assets/menu), but the
# build output and dependencies linger on disk. web-menu/.gitignore went with
# it, so without this a `git add -A` sweeps in ~90 MB of node_modules.
web-menu/

# Godot's import/shader cache. Every byte of it is regenerated by
# `Godot --path godot --headless --import`, but it is ~52 MB across 422 files
# that churn on every reimport, which buried real changes in commits made
# mostly of cache noise. A fresh clone must run that import once before the
# project will open or run.
godot/.godot/
